rules_version = '2';

// SOLO estos correos pueden leer y escribir. Nadie más, aunque logre crear una cuenta.
// Reemplaza los dos correos de ejemplo por los reales, en minúsculas.
service cloud.firestore {
  match /databases/{database}/documents {
    function permitido() {
      return request.auth != null
        && request.auth.token.email in ['correo1@ejemplo.com', 'correo2@ejemplo.com'];
    }
    match /{documento=**} {
      allow read, write: if permitido();
    }
  }
}
